{% extends 'ui/base.html.twig' %}
{% block title %}{{ id ? id ~ ' — ' : 'New analysis — ' }}TA Writer{% endblock %}
{% block head %}<link rel="stylesheet" href="/assets/vendor/quill/quill.snow.css">{% endblock %}
{% block scripts %}
<script src="/assets/vendor/quill/quill.js" defer></script>
<script src="/assets/richtext.js" defer></script>
<script src="/assets/diagram.js" defer></script>
<script src="/assets/docnav.js" defer></script>
<script src="/assets/preview.js" defer></script>
<script src="/assets/collapse.js" defer></script>
{% endblock %}
{% block body %}
<div class="doc-head">
    <div>
        <p class="eyebrow">{{ id ? 'Analysis' : 'New analysis' }}</p>
        <h1>{{ id ? id : 'Untitled analysis' }}</h1>
        {% if id %}
        <div class="meta">
            <span class="pill primary" title="Version of the content">v{{ document.version|default('—') }}</span>
            <span class="pill" title="Structure of the OpenAPI file, read-only">structure {{ document.structureVersion|default('—') }}</span>
            <span class="pill" title="Number of saved versions">{{ history }} saved</span>
        </div>
        {% endif %}
    </div>
    {% if id %}
    <div class="actions">
        <a class="btn ghost" href="/documents/{{ id }}/versions">History</a>
        <a class="btn ghost" href="/documents/{{ id }}/publish">Publish</a>
        <a class="btn ghost" href="/api/documents/{{ id }}" target="_blank" rel="noopener">JSON</a>
        <button type="button" class="ghost preview-toggle" data-preview-toggle aria-expanded="false">Preview<span class="preview-dot" data-preview-dot hidden></span></button>
    </div>
    {% endif %}
</div>

{% if errors is not empty %}
    <div class="flash error" role="alert">
        <strong>The analysis was not saved. Fix these fields:</strong>
        <ul>
            {% for error in errors %}<li><code>{{ error.path }}</code> — {{ error.message }}</li>{% endfor %}
        </ul>
    </div>
{% endif %}

<div class="editor-layout">
<nav class="doc-nav" aria-label="Outline" data-docnav>
    <div class="doc-nav-head"><span>Outline</span><span class="doc-nav-tools"><button type="button" class="ghost small" data-collapse-all title="Collapse every block">Collapse all</button><button type="button" class="ghost small" data-expand-all title="Expand every block">Expand all</button></span></div>
    <input type="search" class="doc-nav-filter" placeholder="Filter (/)" aria-label="Filter the outline" data-docnav-filter>
    <div class="doc-nav-list" data-docnav-list></div>
</nav>
<div class="editor-main">
<form method="post" action="{{ id ? '/documents/' ~ id : '/documents' }}" class="editor" id="editor">
    {% if id %}<input type="hidden" name="_version" value="{{ version }}">{% endif %}
    {# the format the stored values are written in: the rich fields convert from it when the format changes #}
    <input type="hidden" name="_format_original" value="{{ doc_format }}">
    <div class="format-notice" data-format-notice hidden>Saved as <strong data-format-target></strong>. Stored values are converted when you save.</div>
    {% include 'ui/form/node.html.twig' with { node: form, name: 'data', value: document, siblings: null, doc_format: doc_format } only %}
    <div class="savebar">
        <span class="hint">{{ id ? 'Saving creates a new version when the content changes.' : 'The analysis gets version 1.0.0.' }}</span>
        <a class="btn ghost" href="/">Cancel</a>
        <button type="submit" class="primary">{{ id ? 'Save changes' : 'Create analysis' }}</button>
    </div>
</form>
</div>
<aside class="doc-preview" aria-label="Preview" data-preview>
    <div class="doc-preview-head">
        <strong>Preview</strong>
        <span class="doc-preview-status" data-preview-status aria-live="polite"></span>
        <div class="seg" role="group" aria-label="Preview scope">
            <button type="button" class="small" data-preview-mode="section" aria-pressed="true">Section</button>
            <button type="button" class="small" data-preview-mode="document" aria-pressed="false">Document</button>
        </div>
        <button type="button" class="ghost small preview-close" data-preview-close>Close</button>
    </div>
    <div class="preview-warning" role="alert" data-preview-warning hidden>
        <div class="preview-warning-text" data-preview-warning-text></div>
        <ul class="preview-warning-list" data-preview-warning-list hidden></ul>
        <button type="button" class="small" data-preview-retry>Retry</button>
    </div>
    <div class="doc-preview-body" data-preview-body></div>
</aside>
</div>
{% include 'ui/editor/_diagram_modal.html.twig' %}
{% endblock %}
