{% extends 'ui/base.html.twig' %}
{% block title %}Publish {{ id }} — TA Writer{% endblock %}
{% block body %}
<div class="doc-head">
    <div>
        <p class="eyebrow">Publish</p>
        <h1>{{ id }}</h1>
        <div class="meta"><span class="pill">{{ document_version is defined ? 'v' ~ document_version : '' }}</span></div>
    </div>
    <div class="actions"><a class="btn ghost" href="/documents/{{ id }}/edit">← Back to the analysis</a></div>
</div>

{% if result is not null %}
    <section class="result {{ result.status }}" aria-live="polite">
        <h2>
            {% if result.status == 'dry-run' %}Dry run — nothing was written
            {% elseif result.status == 'done' %}Published
            {% else %}Not published{% endif %}
            <span class="pill {{ result.status == 'done' ? 'ok' : (result.status == 'failed' ? 'bad' : 'primary') }}">{{ result.status }}</span>
        </h2>
        <ul class="messages">
            {% for line in result.messages %}<li>{{ line }}</li>{% endfor %}
        </ul>
        {% if result.artifacts is not empty %}
            <p class="small muted" style="margin-top:12px">Files</p>
            <ul class="small">{% for file in result.artifacts %}<li><code>{{ file }}</code></li>{% endfor %}</ul>
        {% endif %}
        {% if result.status == 'dry-run' %}
            <form method="post" action="/documents/{{ id }}/publish" class="confirm">
                <input type="hidden" name="format" value="{{ format }}">
                {% for name, answer in answers %}<input type="hidden" name="options[{{ name }}]" value="{{ answer }}">{% endfor %}
                <input type="hidden" name="confirm" value="1">
                <button type="submit" class="primary">Confirm and publish as {{ format }}</button>
            </form>
        {% endif %}
    </section>
{% endif %}

<div class="publish-grid">
    <section class="card">
        <div class="card-head"><h2>Format</h2></div>
        <div class="format-cards">
            {% for name, label in formats %}
                <a class="format-card{% if name == format %} selected{% endif %}" href="/documents/{{ id }}/publish?format={{ name }}">
                    <span>
                        <span class="fmt-name">{{ label }}</span><br>
                        <span class="fmt-hint">{{ name }}</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </section>

    <section class="card">
        <div class="card-head">
            <div><h2>Options</h2><p>Answers this format needs.</p></div>
        </div>
        <form method="post" action="/documents/{{ id }}/publish">
            <input type="hidden" name="format" value="{{ format }}">
            {% for option in options %}
                <label class="field">
                    <span>{{ option.label }}{% if option.required %} <span class="req">*</span>{% endif %}</span>
                    <input type="text" name="options[{{ option.name }}]" value="{{ answers[option.name] ?? option.default ?? '' }}"{% if option.required %} required{% endif %}>
                </label>
            {% else %}
                <p class="muted">No option for this format.</p>
            {% endfor %}
            <div class="toolbar" style="margin-top:6px">
                <button type="submit" name="dry" value="1">Dry run</button>
                <span class="muted small">Shows what would be written. Nothing is written.</span>
            </div>
        </form>
    </section>
</div>
{% endblock %}
