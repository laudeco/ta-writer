<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}TA Writer{% endblock %}</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<header class="topbar">
    <a class="brand" href="/">TA Writer</a>
    <nav>
        <a href="/">Analyses</a>
        <a href="/documents/new">New analysis</a>
        <a href="/api/documents" target="_blank">API</a>
    </nav>
</header>
<main>
    {% for flash in app.flashes('success') %}<div class="flash ok">{{ flash }}</div>{% endfor %}
    {% for flash in app.flashes('error') %}<div class="flash error">{{ flash }}</div>{% endfor %}
    {% block body %}{% endblock %}
</main>
<script src="/assets/app.js" defer></script>
</body>
</html>
