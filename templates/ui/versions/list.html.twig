{% extends 'ui/base.html.twig' %}
{% block title %}History {{ id }} - TA Writer{% endblock %}
{% block body %}
<div class="page-head">
    <h1>History of <code>{{ id }}</code></h1>
    <a href="/documents/{{ id }}/edit">Back to the analysis</a>
</div>
<table class="grid">
    <thead><tr><th>Version</th><th>Date (UTC)</th><th>Origin</th><th>Changed</th><th></th></tr></thead>
    <tbody>
    {% for row in rows|reverse %}
        {% set version = row.meta %}
        <tr>
            <td>{{ version.number }}{% if version.number == current %} <span class="badge">current</span>{% endif %}</td>
            <td>{{ version.createdAt|date('Y-m-d H:i:s') }}</td>
            <td>{{ version.origin }}</td>
            <td class="small">
                {% for path in version.changedPaths|slice(0, 6) %}<code>{{ path }}</code><br>{% else %}&mdash;{% endfor %}
                {% if version.changedPaths|length > 6 %}<span class="muted">and {{ version.changedPaths|length - 6 }} more</span>{% endif %}
            </td>
            <td class="actions">
                <a href="/documents/{{ id }}/versions/{{ version.number }}">View</a>
                {% if row.previous is not null %}<a href="/documents/{{ id }}/versions/{{ row.previous }}/diff/{{ version.number }}">Diff with previous</a>{% endif %}
                {% if version.number != current %}
                    <form method="post" action="/documents/{{ id }}/versions/{{ version.number }}/restore" class="inline" onsubmit="return confirm('Restore version {{ version.number }} as the new current version? Nothing is deleted.');">
                        <button type="submit">Restore</button>
                    </form>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
