{% extends 'ui/base.html.twig' %}
{% block title %}Version {{ number }} — TA Writer{% endblock %}
{% block body %}
<div class="doc-head">
    <div>
        <p class="eyebrow">Version {{ number }}{% if number == current %} · current{% endif %}</p>
        <h1>{{ id }}</h1>
    </div>
    <div class="actions"><a class="btn ghost" href="/documents/{{ id }}/versions">← History</a></div>
</div>
{% if number != current %}
    <div class="flash"><strong>Read-only view</strong>This is an earlier version. Restore it from the history to make it current.</div>
{% endif %}
<pre class="json">{{ json }}</pre>
{% endblock %}
