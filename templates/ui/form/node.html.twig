{# One node of the generated form. node: FieldNode, name: HTML name, value: current value (or null), siblings: the object holding it, doc_format: format the stored values are written in. Recursive. #}
{% if node.widget == 'object' %}
    <fieldset class="object{% if node.name == 'data' %} root{% endif %}"{% if node.name in ['project', 'author', 'sqlImpact'] %} data-kind="group"{% endif %}{% if node.name in ['project', 'author'] %} data-nav-section="{{ node.name }}"{% endif %}>
        {% if node.name != 'data' %}
            <legend>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</legend>
            {% if node.description %}<p class="help">{{ node.description }}</p>{% endif %}
        {% endif %}
        {% for child in node.displayChildren() %}
            {% include 'ui/form/node.html.twig' with {
                node: child,
                name: name ~ '[' ~ child.name ~ ']',
                value: (value is iterable and value[child.name] is defined) ? value[child.name] : null,
                siblings: value,
                doc_format: doc_format,
            } only %}
        {% endfor %}
    </fieldset>
{% elseif node.widget == 'array' %}
    {% set kind_labels = { epics: 'Epic', userStories: 'User story', technicalStories: 'Technical story', subtasks: 'Subtask', resources: 'Resource', diagrams: 'Diagram', dependencies: 'Dependency', acceptanceCriteria: 'Criterion', acceptanceCriteriaCovered: 'Covered criterion' } %}
    <div class="collection" data-collection data-nav="{{ node.name }}"{% if node.name == 'dependencies' %} data-nav-section="dependencies"{% endif %}>
        <div class="collection-head">
            <strong>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</strong>
            <span class="count" data-count>{{ (value ?? [])|length }}</span>
        </div>
        {% if node.description %}<p class="help">{{ node.description }}</p>{% endif %}
        <div class="items" data-items>
            {% for item in (value ?? []) %}
                <div class="item" data-item data-kind="{{ node.name }}">
                    <div class="item-bar">
                        <span class="item-no">#{{ loop.index }}</span>
                        <span class="item-kind">{{ kind_labels[node.name] ?? node.name }}</span>
                        <button type="button" data-move="up" title="Move up">&uarr;</button>
                        <button type="button" data-move="down" title="Move down">&darr;</button>
                        <button type="button" class="danger" data-remove>Remove</button>
                    </div>
                    {% include 'ui/form/node.html.twig' with { node: node.item, name: name ~ '[' ~ loop.index0 ~ ']', value: item, siblings: null, doc_format: doc_format } only %}
                </div>
            {% endfor %}
        </div>
        <template data-template>
            <div class="item" data-item data-kind="{{ node.name }}">
                <div class="item-bar">
                    <span class="item-no">new</span>
                    <span class="item-kind">{{ kind_labels[node.name] ?? node.name }}</span>
                    <button type="button" data-move="up" title="Move up">&uarr;</button>
                    <button type="button" data-move="down" title="Move down">&darr;</button>
                    <button type="button" class="danger" data-remove>Remove</button>
                </div>
                {% include 'ui/form/node.html.twig' with { node: node.item, name: name ~ '[__INDEX__]', value: null, siblings: null, doc_format: doc_format } only %}
            </div>
        </template>
        <button type="button" class="add" data-add>+ Add {{ node.label|lower }}</button>
    </div>
{% elseif node.widget == 'richtext' %}
    {# A rich field: a Quill editor (initialised lazily by richtext.js), the stored value kept untouched in `original`,
       what the editor produced in `html`, and the Source view in `source`. The mode says which one to use. #}
    {% set original = value is iterable ? '' : (value ?? '') %}
    {% set rich_on = node.richWhen is null or (siblings is iterable and siblings[node.richWhen.field] is defined and siblings[node.richWhen.field] == node.richWhen.equals) %}
    <div class="field wide rich" data-rich
         {% if node.richWhen is not null %}data-when-field="{{ node.richWhen.field }}" data-when-equals="{{ node.richWhen.equals }}"{% endif %}>
        <span class="field-label">{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        {% if node.description %}<small class="help">{{ node.description }}</small>{% endif %}
        {# the rich body is hidden when its condition is off; the plain field stays visible in that case (a resource that is not a note) #}
        <div data-rich-body{% if not rich_on %} hidden{% endif %}>
            <div class="rich-shell" data-rich-shell data-format="{{ doc_format }}">
                <div class="rich-editor" data-rich-editor data-html="{{ rich_html(original, doc_format) }}" data-rich-ready="false"></div>
                <div class="rich-source" data-rich-source-view hidden>
                    <textarea name="{{ name }}[source]" class="code" rows="8" aria-label="{{ node.label }} source"{% if not rich_on %} disabled{% endif %}>{{ original }}</textarea>
                </div>
            </div>
            <input type="hidden" name="{{ name }}[original]" value="{{ original }}"{% if not rich_on %} disabled{% endif %}>
            <input type="hidden" name="{{ name }}[mode]" value="raw" data-rich-mode{% if not rich_on %} disabled{% endif %}>
            <input type="hidden" name="{{ name }}[html]" value="" data-rich-html{% if not rich_on %} disabled{% endif %}>
        </div>
        {% if node.richWhen is not null %}
            <textarea class="plain-fallback" name="{{ name }}" rows="3" placeholder="URL, ticket key or text" aria-label="{{ node.label }}"{% if rich_on %} disabled hidden{% endif %}>{{ original }}</textarea>
        {% endif %}
    </div>
{% elseif node.widget == 'author' %}
    {# An author chosen in the list (Authors page): the first one is the default of a new analysis. The hidden name and
       username carry the copy stored in the document, kept when its email is no longer in the list. #}
    {% set current = value is iterable ? value : {} %}
    {% set current_email = current.email ?? '' %}
    {% set listed = author_options() %}
    {% set listed_emails = listed|map(a => a.email) %}
    <label class="field author-field">
        <span>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        <select name="{{ name }}[email]" data-author-select>
            {% if listed is empty %}<option value="">Add an author first</option>{% endif %}
            {% for a in listed %}
                <option value="{{ a.email }}"{% if (current_email == '' and loop.first) or current_email == a.email %} selected{% endif %}>{{ a.name }} &lt;{{ a.email }}&gt;</option>
            {% endfor %}
            {% if current_email != '' and current_email not in listed_emails %}
                <option value="{{ current_email }}" selected>{{ current.name ?? current_email }} &lt;{{ current_email }}&gt; (not in the list)</option>
            {% endif %}
        </select>
        <input type="hidden" name="{{ name }}[name]" value="{{ current.name ?? '' }}">
        <input type="hidden" name="{{ name }}[username]" value="{{ current.username ?? '' }}">
        {% if listed is empty %}<small class="help"><a href="/authors">Add an author</a> to choose one.</small>{% endif %}
    </label>
{% elseif node.widget == 'reference' %}
    {# A reference of the document: a dropdown filled with the references by references.js. The stored value is kept selected
       even before the script runs, and even when it no longer exists in the document (the validation reports it). #}
    <label class="field reference-field" data-reference-field>
        <span>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        <select name="{{ name }}" data-reference-select data-value="{{ value }}"{% if node.readOnly %} disabled{% endif %}>
            <option value="">&mdash;</option>
            {% if value is not empty %}<option value="{{ value }}" selected>{{ value }}</option>{% endif %}
        </select>
        {% if node.description %}<small class="help">{{ node.description }}</small>{% endif %}
    </label>
{% elseif node.widget == 'select' %}
    <label class="field">
        <span>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        <select name="{{ name }}"{% if node.readOnly %} disabled{% endif %} data-field="{{ node.name }}">
            <option value="">&mdash;</option>
            {% for option in node.options %}
                <option value="{{ option }}"{% if value == option %} selected{% endif %}>{{ option }}</option>
            {% endfor %}
        </select>
        {% if node.description %}<small class="help">{{ node.description }}</small>{% endif %}
    </label>
{% elseif node.widget == 'code' %}
    {# A diagram (Mermaid source): a card with a thumbnail. The source stays in a hidden textarea, so it is submitted as it
       is; View and Edit open the diagram modal (ui/editor/_diagram_modal.html.twig, diagram.js). #}
    <div class="field wide diagram-field" data-diagram>
        <span class="field-label">{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        {% if node.description %}<small class="help">{{ node.description }}</small>{% endif %}
        <textarea name="{{ name }}" hidden class="code" data-diagram-source>{{ value }}</textarea>
        <div class="diagram-card">
            <div class="diagram-thumb" data-diagram-thumb role="button" tabindex="0" aria-label="View the diagram" title="View the diagram"><span class="muted">Diagram</span></div>
            <div class="diagram-meta">
                <code class="diagram-first" data-diagram-first>{{ (value ?? '')|split("\n")|first|default('(empty diagram)') }}</code>
                <span class="pill">{{ (value ?? '')|split("\n")|length }} lines</span>
            </div>
            <div class="diagram-actions">
                <button type="button" class="ghost small" data-diagram-open="view">View</button>
                <button type="button" class="small" data-diagram-open="edit">Edit</button>
            </div>
        </div>
    </div>
{% elseif node.widget == 'textarea' %}
    <label class="field wide">
        <span>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        <textarea name="{{ name }}" rows="{{ node.widget == 'code' ? 10 : 4 }}" class="{{ node.widget }}"{% if node.placeholder %} placeholder="{{ node.placeholder }}"{% endif %}>{{ value }}</textarea>
        {% if node.description %}<small class="help">{{ node.description }}</small>{% endif %}
    </label>
{% else %}
    {% set input = node.widget == 'integer' ? 'number' : (node.widget == 'url' ? 'url' : (node.widget == 'email' ? 'email' : 'text')) %}
    <label class="field">
        <span>{{ node.label }}{% if node.required %} <span class="req">*</span>{% endif %}</span>
        <input type="{{ input }}" name="{{ name }}" value="{{ value }}"{% if node.placeholder %} placeholder="{{ node.placeholder }}"{% endif %}{% if node.widget == 'integer' %} min="0" step="1"{% endif %}{% if node.readOnly %} readonly class="readonly"{% endif %}>
        {% if node.description %}<small class="help">{{ node.description }}</small>{% endif %}
    </label>
{% endif %}
