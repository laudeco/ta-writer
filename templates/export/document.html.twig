{# PDF body, assembled from the partials of export/pdf. Same content as the Markdown export. #}
{% for epic in doc.epics %}
<htmlpageheader name="epic{{ loop.index }}" style="display:none">
    <table class="runhead"><tr>
        <td>{{ doc.project.reference|default('') }}</td>
        <td class="r"><span class="epic">{{ epic.displayTitle|slice(0, 90) }}</span></td>
    </tr></table>
</htmlpageheader>
{% endfor %}

<htmlpageheader name="project" style="display:none">
    <table class="runhead"><tr>
        <td>{{ doc.project.name|default('Technical analysis') }}</td>
        <td class="r">{{ doc.project.reference|default('') }}</td>
    </tr></table>
</htmlpageheader>

<sethtmlpageheader name="project" value="on" show-this-page="0"></sethtmlpageheader>
{% include 'export/pdf/_cover.html.twig' with { doc: doc, stats: stats } only %}

<sethtmlpageheader name="project" value="on" show-this-page="1"></sethtmlpageheader>
<tocpagebreak links="1" toc-preHTML="&lt;div class=&quot;toc-title&quot;&gt;Contents&lt;/div&gt;" />

{% for epic in doc.epics %}
    {% include 'export/pdf/_epic.html.twig' with { epic: epic, doc: doc, index: loop.index, first: loop.first } only %}
    {% for ts in epic.technicalStories %}
        {% include 'export/pdf/_ts.html.twig' with { ts: ts, doc: doc } only %}
        {% for sub in ts.subtasks %}
            {% include 'export/pdf/_subtask.html.twig' with { sub: sub, doc: doc } only %}
        {% endfor %}
    {% endfor %}
{% endfor %}

{% include 'export/pdf/_closing.html.twig' with { doc: doc } only %}
