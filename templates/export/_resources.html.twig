{% if resources is not empty %}
<div class="resources">
    <span class="label">Resources</span>
    {% for resource in resources %}
        <div class="small" style="margin-top:3pt"><span class="tag">{{ resource.type }}</span>{% if resource.type == 'link' or resource.type == 'image' %}<a href="{{ resource.content }}">{{ resource.content }}</a>{% elseif resource.type == 'note' %}<div class="text">{{ resource.content|content_html(format) }}</div>{% else %}{{ resource.content }}{% endif %}</div>
    {% endfor %}
</div>
{% endif %}
