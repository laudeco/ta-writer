{# one subtask: a card; nothing is split across pages #}
<div class="card" style="page-break-inside: avoid">
    <div class="card-head">
        <div class="ref">{{ sub.reference }}</div>
        <div class="title">{{ sub.title }}</div>
    </div>
    <div class="card-body">
        {% if sub.featureToggle is not null or sub.sqlImpact is not null or sub.criterion is not null %}
        <div class="card-meta">
            {% if sub.featureToggle is not null %}<span class="chip">toggle {{ sub.featureToggle }}</span>{% endif %}
            {% if sub.sqlImpact is not null %}<span class="chip warn">{{ sub.sqlImpact.nbColumns }} col · {{ sub.sqlImpact.nbRows }} rows</span>{% endif %}
            {% if sub.criterion is not null %}<span class="chip ok">{{ sub.criterion }}</span>{% endif %}
        </div>
        {% endif %}
        {% if sub.what is not empty %}<h5>What</h5><div class="text">{{ sub.what|content_html(doc.format) }}</div>{% endif %}
        {% if sub.why is not empty %}<h5>Why</h5><div class="text">{{ sub.why|content_html(doc.format) }}</div>{% endif %}
        {% if sub.where is not empty %}<h5>Where</h5><div class="text">{{ sub.where|content_html(doc.format) }}</div>{% endif %}
        {% if sub.how is not empty %}<h5>How</h5><div class="text">{{ sub.how|content_html(doc.format) }}</div>{% endif %}
        {% include 'export/_resources.html.twig' with { resources: sub.resources, format: doc.format } only %}
        {% for diagram in sub.diagrams %}<div class="diagram-block">{{ mermaid_img(diagram.content) }}</div>{% endfor %}
    </div>
</div>
