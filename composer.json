{
    "name": "ta-writer/ta-writer",
    "description": "JSON-driven technical analysis writer: store, edit through a REST API and publish analyses.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.1",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "chrome-php/chrome": "*",
        "league/commonmark": "*",
        "league/html-to-markdown": "*",
        "mpdf/mpdf": "*",
        "opis/json-schema": "*",
        "symfony/browser-kit": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation-contracts": "*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/twig": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
