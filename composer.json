{
    "name": "ta-writer/ta-writer",
    "description": "JSON-driven technical analysis writer: store, edit through a REST API and publish analyses.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.3",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/http-kernel": "6.4.*",
        "symfony/routing": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/string": "6.4.*",
        "symfony/translation-contracts": "^3.4",
        "symfony/yaml": "6.4.*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
