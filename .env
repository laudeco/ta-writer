APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-local-only
# Relative to the project root. Analyses are stored in data/ (gitignored).
TA_STORAGE_DIR=data/analyses
TA_EXPORT_DIR=data/exports
# 0 = keep every version.
TA_HISTORY_MAX=0
# seconds after the last change before the editor saves a new version (0 = off)
TA_AUTOSAVE_SECONDS=5

# Diagrams (mermaid-cli) and the AGIR browser. The container image sets the same values.
MMDC_BIN=mmdc
MMDC_PUPPETEER_CONFIG=/etc/ta-writer/puppeteer-config.json
CHROME_BIN=/usr/bin/chromium
AGIR_PROFILE_DIR=data/chrome-profile

# Endpoints. Secrets (CONFLUENCE_PAT, JIRA_PAT) are never in this file: put them in .env.local.
CONFLUENCE_BASE_URL=https://espace.agir.orange.com
JIRA_BASE_URL=https://portail.agir.orange.com
